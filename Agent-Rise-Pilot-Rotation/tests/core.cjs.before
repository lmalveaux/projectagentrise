const fs=require('node:fs'),vm=require('node:vm'),assert=require('node:assert/strict'),crypto=require('node:crypto'),path=require('node:path');
const root=path.resolve(__dirname,'..');const nodes=new Map();
const node=id=>{if(!nodes.has(id))nodes.set(id,{value:'',textContent:'',innerHTML:'',dataset:{},classList:{add(){},remove(){},toggle(){}},addEventListener(){},setAttribute(){},getAttribute(){return '';},style:{},focus(){}});return nodes.get(id);};
const context={console,crypto:crypto.webcrypto,structuredClone,URL,URLSearchParams,Date,setTimeout,clearTimeout,alert(){},confirm(){return true;},localStorage:{getItem(){return null;},setItem(){}},document:{querySelector:node,getElementById:node,querySelectorAll(){return[];},addEventListener(){},body:node('body')},window:{matchMedia(){return {matches:false,addEventListener(){}};},AGENT_RISE_CONFIG:{}}};
vm.createContext(context);
let base=fs.readFileSync(path.join(root,'Agent-Rise.html'),'utf8').match(/<script>([\s\S]*?)<\/script>/)[1];base=base.replace('      renderBreakroomTables();','').replace('      bindBreakroomEvents();','');vm.runInContext(base,context);
let extra=fs.readFileSync(path.join(root,'pilot.js'),'utf8').split('const originalMoveToNew=')[0];vm.runInContext(extra,context);
const run=code=>vm.runInContext(code,context);
assert.equal(run("permissionExpiry('2024-02-29')"),'2025-02-28');assert.equal(run("permissionExpiry('2024-02-30')"),'');assert.equal(run("permissionExpiry('garbage')"),'');
assert.equal(run("revisionValue(4)"),4);assert.equal(run("revisionValue('42')"),42);assert.equal(run("revisionValue(null)"),0);assert.equal(run("revisionValue('invalid')"),0);
run("var testProspect={id:crypto.randomUUID(),product:'Medicare Advantage',ptcSource:'BRC',ptcSignedDate:todayIsoDate(),soaCompleted:'Yes',soaDate:todayIsoDate(),soaMethod:'Electronic Record',marketingEligibility:'Active Insurance Prospect'}");
assert.equal(run('contactBlock(testProspect)'), '');for(const override of ["{ptcSignedDate:'2020-01-01'}","{soaCompleted:'No'}","{leadPool:'Do Not Contact'}","{soaDate:'2999-01-01'}","{ptcSource:'Not on File'}"]){assert.ok(run(`contactBlock({...testProspect,...${override}})`));}
assert.ok(run("contactBlock({...testProspect,marketingEligibility:'Review Needed'},{automated:true})"));
assert.equal(run("trainingStart({date:'2026-09-15',time:'09:30:00'}).getHours()"),9);
assert.throws(()=>run("migrateBackup({schemaVersion:999,prospects:[]})"));
assert.throws(()=>run("migrateBackup({prospects:[null]})"));
run("var migrated=migrateBackup([{id:'legacy',firstName:'Kept',leadPool:'Do Not Contact'}]);state.prospects=migrated.prospects;trackChanges()");assert.equal(run('state.prospects[0].leadPool'),'Do Not Contact');assert.equal(run('state.prospects[0].createdAt'),undefined);assert.match(run('state.prospects[0].id'),/^[a-f0-9-]{36}$/);
run("state.prospects=[{...testProspect,status:'Client',createdAt:new Date().toISOString()}];previousProspects.clear();trackChanges()");assert.equal(run("pilot.events.filter(e=>e.type==='close').length"),1);
assert.equal(run("safeUrl('javascript:alert(1)')"),'');assert.equal(run("safeUrl('https://example.com/portal')"),'https://example.com/portal');
assert.equal(run("scrubErrorText('key sb_secret_example123')"),'key [redacted Supabase secret]');
assert.equal(run("scrubErrorText('Authorization: Bearer abc.def.ghi')"),'Authorization: Bearer [redacted]');
assert.match(run("errorDetail({message:'save failed',code:'PGRST205'})"),/message: save failed[\s\S]*code: PGRST205/);
assert.equal(run("normalizeWorkspaceData({}).dailyGoal"),5);assert.equal(run("normalizeWorkspaceData({dailyGoal:-2}).dailyGoal"),0);
run("pilot.workspaceData=normalizeWorkspaceData({dailyGoal:7,campaigns:[{name:'Fall Fair'}],referrals:[{name:'Lee'}],freshPourNotes:{medicare:'Remember IRMAA'}})");
assert.equal(run("snapshot().profile.workspaceData.dailyGoal"),7);assert.equal(run("snapshot().profile.workspaceData.freshPourNotes.medicare"),'Remember IRMAA');
assert.ok(fs.readFileSync(path.join(root,'supabase','schema.sql'),'utf8').includes("'workspaceData',a.workspace_data"));
const pilotSource=fs.readFileSync(path.join(root,'pilot.js'),'utf8');assert.ok(pilotSource.includes('const MAX_ATTEMPTS = 3;'));assert.ok(pilotSource.includes("await pilot.db.rpc('load_agent_workspace')"));assert.ok(pilotSource.includes("notify('Syncing latest changes…')"));
for(const file of ['pilot.js','config.js'])new vm.Script(fs.readFileSync(path.join(root,file),'utf8'));
console.log('PASS: core consent, leap-year dates, cloud time formats, migrations, workspace persistence, legacy date preservation, close events, URL validation, and syntax.');
